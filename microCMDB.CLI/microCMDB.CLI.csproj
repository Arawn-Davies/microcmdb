<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- No .NET 6 runtime is installed locally; allow the net6.0-targeted app
		     to roll forward onto a newer installed runtime (net8/net9). -->
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<FileWrites Include="Util\BuildInfo.cs" />
		<!-- BuildInfo.cs is generated by the GetVersion target below and is not
		     committed (gitignored). The default **/*.cs glob is existence-filtered
		     at evaluation, so on a clean checkout (e.g. CI) the file isn't there yet
		     and wouldn't be compiled. Explicitly include it by path (explicit
		     includes aren't existence-filtered) and Remove first to avoid a
		     duplicate when the file does exist locally. -->
		<Compile Remove="Util\BuildInfo.cs" />
		<Compile Include="Util\BuildInfo.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
	</ItemGroup>
	
	<PropertyGroup>
		<Year>$([System.DateTime]::Now.ToString("yyyy"))</Year>
		<Month>$([System.DateTime]::Now.ToString("MM"))</Month>
		<Date>$([System.DateTime]::Now.ToString("dd"))</Date>
		<Time>$([System.DateTime]::Now.ToString("HHmm"))</Time>
		<GenVerCS>
namespace microCMDB.CLI.Util
{

	///<summary>
	///Class definition for microCMDB.common.Util
	///</summary>
    public class BuildInfo
    {
		///<summary>
		///The kernel build number, generated upon a new build
		///</summary>
		public static string BuildNumber = "$(Year)$(Month)$(Date)$(Time)"%3b
	}
}
		</GenVerCS>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>


	<Target Name="GetVersion" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="Util\BuildInfo.cs">
		<WriteLinesToFile File="Util\BuildInfo.cs" Lines="$(GenVerCS)" Overwrite="true"></WriteLinesToFile>
	</Target>
	
</Project>
